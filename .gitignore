### General ###

# OS-generated files
#---------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

# IDE configuration files
#---------------------------------
# Visual Studio Code
# Ignore everything in .vscode directories...
**/.vscode/*
# ...but re-include files that are meant to be shared
!**/.vscode/settings.json
!**/.vscode/extensions.json
!**/.vscode/launch.json
!**/.vscode/tasks.json

# IntelliJ
.idea/

# Eclipse
.project
.classpath
.settings/

### Backend (Java & Gradle) ###
#---------------------------------
# Gradle
/app/backend/.gradle
/app/backend/build/

# Compiled Java classes
bin/
*.class

# Log files
*.log

# Package files. We ignore all jars by default...
*.jar
*.war
*.ear

# ...except the Gradle wrapper, which must be checked in.
!/app/backend/gradle/wrapper/gradle-wrapper.jar

### Frontend (JavaScript) ###
#---------------------------------
# Node.js dependencies
node_modules/
bower_components/

# Build outputs
dist/
build/
out/

# Log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test coverage
coverage/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local 